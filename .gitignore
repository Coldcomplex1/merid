node_modules
dist
*.local
.DS_Store
npm-debug.log*

# Blog SSR bundle: an intermediate build artifact consumed by
# scripts/prerender.mjs and never deployed. Rebuilt by `npm run blog:ssr`.
.blog-ssr

# Python virtualenv for the visual pipeline's stage 04 (CLIP). Made by
# `python3 -m venv .venv` at the repository root, ~2GB, and regenerable from
# the one pip install line in docs/HUONG-DAN-ANH-TU-VUNG.md.
.venv/

# Environment files — never commit real Firebase config/secrets (.env.local is
# already covered by *.local; this catches every other .env variant).
.env
.env.*
!.env.example

# Firebase emulator artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Extension build artifact (rebuilt by merid-extension-final `npm run build`)
dist.zip

# Visual-vocabulary pipeline working files. Everything here is regenerable from
# the CSVs plus the APIs, except decisions.json - the record of which candidate
# a human picked for each word, which is the one thing in the pipeline that
# cannot be recomputed and IS committed.
scripts/visual/state/*
!scripts/visual/state/decisions.json
