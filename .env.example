# Firebase web app config — copy to .env.local and fill in the values from
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
#
# NOTE: these values identify the project, they are not secrets — real access
# control lives in firestore.rules and the API-key restrictions described in
# docs/FIREBASE_SETUP.md. Still keep .env.local out of git so each environment
# (dev/prod) can point at its own project.
#
# All vars are OPTIONAL: when absent the app falls back to Merid's public
# project identifiers (src/lib/firebase.ts) so login never silently disappears
# on a deploy with missing env config. Only API_KEY / AUTH_DOMAIN / PROJECT_ID
# affect auth + Firestore; the rest are passed through when set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — set these in the Vercel project, never in a client bundle.
#
# DO NOT add a VITE_ prefix to anything below. Vite inlines every VITE_ variable
# into the JavaScript it ships, so `VITE_UPSTASH_REDIS_REST_TOKEN` would publish
# a write-capable database token to every visitor. The variables above are safe
# to inline (they only identify the Firebase project); these are not.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase project id, used server-side to verify ID tokens and read admins/{uid}.
FIREBASE_PROJECT_ID=

# Upstash Redis (REST). Backs both the AI-check quota (api/check.js) and the
# visitor counter behind /admin. Without these the counter records nothing and
# the dashboard shows a setup panel; nothing else on the site is affected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Salts the daily one-way hash that counts a returning visitor once
# per day. Any long random string. Absent, a built-in constant is used: the hash
# is weaker but the counter still works.
ANALYTICS_SALT=

# ---- AI context check: the model providers behind /api/check ----------------
# Qwen answers first, Gemini is the fallback. Either alone is a working deploy.
# Both take a comma-separated list, so adding capacity is a config change.
# See docs/AI_PROXY_SETUP.md sections 1 and 1b.

# Alibaba Model Studio (Qwen) keys, comma-separated. `sk-...`
QWEN_API_KEYS=

# Optional. Only set this if the key came from the MAINLAND China console:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# Absent, the international (Singapore) endpoint is used. A key from one
# console is a flat 401 on the other, so this is the first thing to check when
# every Qwen call fails.
QWEN_BASE_URL=

# Optional. An explicit ordered model list, e.g. "qwen3.7-flash,qwen3.7-plus",
# which overrides the built-in ranking. Absent, the pool asks the key what it
# can run and ranks it flash-first.
QWEN_MODELS=

# Optional. Provider order; "qwen,gemini" is the default. Set to "gemini" to
# take Qwen out of rotation without a deploy.
MERID_AI_PROVIDERS=

# Gemini API keys for the AI context check, comma-separated.
GEMINI_API_KEYS=

# Cloudinary, for blog image uploads. See BLOG_WORKFLOW.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# THE ARTWORK PIPELINE — scripts/visual/, not the web app.
#
# These are read by the vocabulary-picture pipeline (see
# docs/HUONG-DAN-ANH-TU-VUNG.md), from a `.env` at the repository root. Copy the
# three lines below into `.env` and a run survives closing the terminal - which
# matters, because a full run takes about three hours and often has to be
# finished the next day once the model quota resets.
#
# Note the SINGULAR name here. GEMINI_API_KEYS above (plural) is the web app's,
# and the pipeline accepts either - but one key under one name is the simpler
# thing to have.
#
# An environment variable set in the terminal always wins over this file, so a
# one-off `$env:MERID_CLIP_FLOOR='0.16'` still overrides it.
# ─────────────────────────────────────────────────────────────────────────────

# Required: stages 01, 02 and 02b classify and label with it.
GEMINI_API_KEY=

# Optional: one of three picture archives. Without it Openverse and Wikimedia
# still run, with a smaller pool to choose from.
PEXELS_API_KEY=

# Optional and free: raises Openverse's anonymous rate limit.
# https://api.openverse.org/v1/auth_tokens/register/
OPENVERSE_TOKEN=
