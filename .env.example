# Firebase web app config — copy to .env.local and fill in the values from
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
#
# NOTE: these values identify the project, they are not secrets — real access
# control lives in firestore.rules and the API-key restrictions described in
# docs/FIREBASE_SETUP.md. Still keep .env.local out of git so each environment
# (dev/prod) can point at its own project.
#
# All vars are OPTIONAL: when absent the app falls back to Merid's public
# project identifiers (src/lib/firebase.ts) so login never silently disappears
# on a deploy with missing env config. Only API_KEY / AUTH_DOMAIN / PROJECT_ID
# affect auth + Firestore; the rest are passed through when set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — set these in the Vercel project, never in a client bundle.
#
# DO NOT add a VITE_ prefix to anything below. Vite inlines every VITE_ variable
# into the JavaScript it ships, so `VITE_UPSTASH_REDIS_REST_TOKEN` would publish
# a write-capable database token to every visitor. The variables above are safe
# to inline (they only identify the Firebase project); these are not.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase project id, used server-side to verify ID tokens and read admins/{uid}.
FIREBASE_PROJECT_ID=

# Upstash Redis (REST). Backs both the AI-check quota (api/check.js) and the
# visitor counter behind /admin. Without these the counter records nothing and
# the dashboard shows a setup panel; nothing else on the site is affected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Salts the daily one-way hash that counts a returning visitor once
# per day. Any long random string. Absent, a built-in constant is used: the hash
# is weaker but the counter still works.
ANALYTICS_SALT=

# Gemini API keys for the extension's AI context check, comma-separated.
GEMINI_API_KEYS=

# Cloudinary, for blog image uploads. See BLOG_WORKFLOW.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
