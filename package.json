{
  "name": "merid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run blog:ssr && node scripts/prerender.mjs --check-manifest",
    "blog:ssr": "vite build --ssr src/blog/entry-server.tsx --outDir .blog-ssr",
    "blog:manifest": "npm run blog:ssr && node scripts/prerender.mjs --manifest-only",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.mjs\"",
    "test:api": "node --test test/api.test.mjs test/blog.test.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/lora": "^5.2.5",
    "firebase": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
