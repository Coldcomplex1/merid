rules_version = '2';

// Merid Firestore security rules.
//
// Layout:
//   users/{uid}                – profile + daily write counter (rate limit)
//   users/{uid}/words/{wordId} – one document per saved/known word,
//                                wordId == normalized (lowercase) word
//   users/{uid}/settings/ai    – private per-user settings (the user's own
//                                Gemini API key for the extension's AI check)
//
// Guarantees:
//   A01 – only request.auth.uid == uid can touch anything under users/{uid};
//         everything else is default-deny, so user A can never read or write
//         user B's deck regardless of what uid/payload they claim.
//   A03 – every field is type-, shape- and length-checked at the database
//         boundary, so malformed or oversized payloads are rejected even if
//         client-side validation is bypassed.
//   A04 – creating a word requires atomically bumping the owner's daily
//         counter (same batch), capped at DAILY_LIMIT words per UTC day.
service cloud.firestore {
  match /databases/{database}/documents {

    // Max words a single account may create per UTC day (abuse cap).
    function dailyLimit() { return 200; }

    // Days since Unix epoch (UTC). Clients compute Math.floor(Date.now() / 86400000).
    function today() { return int(request.time.toMillis() / 86400000); }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) && validUserDoc();

      // createdAt is immutable; the counter may only move forward within a day.
      allow update: if isOwner(uid)
        && validUserDoc()
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.countDay != resource.data.countDay
          || request.resource.data.wordCountToday >= resource.data.wordCountToday
        );

      // The profile/counter doc must never be deleted (it anchors the rate limit).
      allow delete: if false;

      function validUserDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['createdAt', 'wordCountToday', 'countDay'])
          && d.keys().hasAll(['createdAt', 'wordCountToday', 'countDay'])
          && d.createdAt is timestamp
          && d.wordCountToday is int
          && d.wordCountToday >= 0
          && d.wordCountToday <= dailyLimit()
          && d.countDay is int
          && d.countDay == today();
      }

      // Private per-user settings. Only the fixed 'ai' doc exists: it backs up
      // the user's OWN Gemini API key so it follows them across devices.
      // Owner-only (A01) with a strict schema (A03) - no other doc id, no
      // extra fields, no oversized/binary payloads.
      match /settings/ai {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAiSettings();

        function validAiSettings() {
          let d = request.resource.data;
          return d.keys().hasOnly(['geminiKey', 'updatedAt'])
            && d.keys().hasAll(['geminiKey', 'updatedAt'])
            && d.geminiKey is string
            && d.geminiKey.size() >= 1
            && d.geminiKey.size() <= 128
            // Google API keys are URL-safe token characters only - rejects
            // whitespace, control chars and anything markup-shaped.
            && d.geminiKey.matches('[A-Za-z0-9_\\-]+')
            && d.updatedAt == request.time;
        }
      }

      // Learned personalization profile. Only the fixed 'state' doc exists:
      // it holds aggregate counts about vocabulary (how often a word was
      // shown, rated, saved) so the reader's preferences follow them across
      // devices. No page content, no URLs, no browsing history.
      //
      // The payload is one JSON string rather than a nested map: its shape is
      // owned by the extension's ranker and changes as that evolves, so the
      // rules validate a type and a size instead of chasing that shape.
      // Owner-only (A01), strict schema (A03), capped well under the 1 MiB
      // document limit.
      match /profile/state {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProfile();

        function validProfile() {
          let d = request.resource.data;
          return d.keys().hasOnly(['state', 'updatedAt'])
            && d.keys().hasAll(['state', 'updatedAt'])
            && d.state is string
            && d.state.size() >= 2
            && d.state.size() <= 200000
            && d.updatedAt == request.time;
        }
      }

      match /words/{wordId} {
        allow read: if isOwner(uid);

        // Creating a word must, in the same batch/transaction, bump the
        // owner's daily counter — otherwise the write is rejected. This is
        // what enforces the per-day cap without Cloud Functions.
        allow create: if isOwner(uid)
          && validWord(wordId)
          && request.resource.data.createdAt == request.time
          && counterBumped();

        // Status flips (saved <-> known) and content refreshes; identity and
        // creation time are immutable.
        allow update: if isOwner(uid)
          && validWord(wordId)
          && request.resource.data.word == resource.data.word
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isOwner(uid);

        function userDocPath() {
          return /databases/$(database)/documents/users/$(uid);
        }

        function counterBumped() {
          let after = getAfter(userDocPath()).data;
          return after.countDay == today()
            && after.wordCountToday <= dailyLimit()
            && (
              !exists(userDocPath())
                // First ever write: batch must create the user doc at count 1.
                ? after.wordCountToday == 1
                : (
                  get(userDocPath()).data.countDay == today()
                    // Same day: exactly +1 per created word.
                    ? after.wordCountToday == get(userDocPath()).data.wordCountToday + 1
                    // New day: counter restarts at 1.
                    : after.wordCountToday == 1
                )
            );
        }

        // Schema validation at the DB boundary. wordId must equal the
        // normalized word itself, which both prevents duplicates (one doc per
        // word) and stops path/payload mismatch tricks.
        function validWord(wordId) {
          let d = request.resource.data;
          return d.keys().hasOnly(['word', 'vietnamese', 'definition', 'example',
                                   'pos', 'status', 'datasets', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['word', 'status', 'createdAt', 'updatedAt'])
            && d.word is string
            && d.word == wordId
            && d.word.size() >= 1
            && d.word.size() <= 64
            && d.word == d.word.lower()
            // Lowercase words/phrases only: letters plus internal space,
            // hyphen or apostrophe. No control chars, no HTML, no leading or
            // trailing whitespace.
            && d.word.matches("[a-z](?:[a-z '-]*[a-z])?")
            && d.status is string
            && d.status in ['saved', 'known']
            && (!('vietnamese' in d) || (d.vietnamese is string && d.vietnamese.size() <= 128))
            && (!('definition' in d) || (d.definition is string && d.definition.size() <= 512))
            && (!('example' in d) || (d.example is string && d.example.size() <= 1024))
            && (!('pos' in d) || (d.pos is string && d.pos.size() <= 32))
            && (!('datasets' in d) || (d.datasets is list
                                       && d.datasets.size() <= 4
                                       && d.datasets.hasOnly(['SAT', 'B2', 'C1', 'C2'])))
            && d.createdAt is timestamp
            && d.updatedAt == request.time;
        }
      }
    }

    // Write-only feedback mailbox for the uninstall exit survey on
    // merid.site/goodbye. Anonymous create is intentional (the extension is
    // already gone, so there is no session): abuse is bounded by the strict
    // schema below, by never allowing read/list (nothing to scrape), and by
    // never allowing update/delete (nothing to vandalize). Only the project
    // owner reads these, via the Firebase console.
    match /feedback/{feedbackId} {
      allow read, list, update, delete: if false;
      allow create: if validFeedback();

      function validFeedback() {
        let d = request.resource.data;
        return d.keys().hasOnly(['source', 'reasons', 'comment', 'lang', 'createdAt'])
          && d.keys().hasAll(['source', 'reasons', 'createdAt'])
          && d.source == 'uninstall'
          && d.reasons is list
          && d.reasons.size() <= 8
          && d.reasons.hasOnly(['too-many', 'wrong-sites', 'not-useful', 'performance',
                                'privacy', 'switched', 'testing', 'other'])
          // An empty submission carries no signal - require a reason or a comment.
          && (d.reasons.size() >= 1 || (('comment' in d) && d.comment.size() >= 1))
          && (!('comment' in d) || (d.comment is string && d.comment.size() <= 500))
          && (!('lang' in d) || d.lang in ['en', 'vi'])
          && d.createdAt == request.time;
      }
    }

    // Blog admin allowlist. One document per admin, created by hand in the
    // Firebase console; the document's existence IS the grant, so no UID and no
    // credential ever lands in the repository. Clients may check their own
    // status (the admin UI needs to know whether to render), but nobody can
    // write here from the outside - promoting an admin is a console action.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    function isBlogAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Blog posts. Document id is "<lang>__<slug>", which makes the public
    // lookup a direct get() and makes slug collision a single existence check.
    //
    // These rules are the actual authorization boundary. The admin screen is
    // just a UI; hiding it protects nothing. A draft is unreadable here even to
    // someone calling the Firestore REST API by hand, which is what lets the
    // public renderer fetch unauthenticated and still never leak an unpublished
    // post.
    //
    // Note on `list`: rules cannot filter a query, they can only reject it. An
    // anonymous list therefore only succeeds when the query itself carries
    // where('status','==','published') - any broader query fails closed rather
    // than returning drafts.
    match /posts/{postId} {
      allow get, list: if resource.data.status == 'published' || isBlogAdmin();
      allow create: if isBlogAdmin() && validPost() && postIdMatchesPayload(postId);
      allow update: if isBlogAdmin() && validPost() && postIdMatchesPayload(postId)
                    && request.resource.data.slug == resource.data.slug
                    && request.resource.data.lang == resource.data.lang;
      allow delete: if isBlogAdmin();

      // The id encodes lang and slug, so a mismatched payload would make the
      // document unreachable at its own URL. Checked here so it cannot happen.
      function postIdMatchesPayload(id) {
        return id == request.resource.data.lang + '__' + request.resource.data.slug;
      }

      // Shape check at the database boundary, so a bug in the editor cannot
      // write a post the renderer will choke on.
      function validPost() {
        let d = request.resource.data;
        return d.keys().hasAll(['slug', 'lang', 'title', 'excerpt', 'content',
                                'author', 'status', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['slug', 'lang', 'title', 'excerpt', 'content',
                               'author', 'tags', 'coverImage', 'coverAlt',
                               'seoTitle', 'seoDescription', 'status',
                               'publishedAt', 'createdAt', 'updatedAt',
                               'translationKey', 'faq', 'canonicalUrl'])
          && d.lang in ['vie', 'en']
          && d.status in ['draft', 'published']
          && d.slug is string && d.slug.size() >= 1 && d.slug.size() <= 120
          && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 200
          && d.excerpt is string && d.excerpt.size() <= 400
          && d.content is string && d.content.size() <= 200000
          && d.author is string && d.author.size() <= 100
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12))
          && (!('faq' in d) || (d.faq is list && d.faq.size() <= 20))
          // A published post must carry the date the renderer sorts and
          // <time>-stamps it by, so "published with no date" is unrepresentable.
          && (d.status != 'published' || 'publishedAt' in d);
      }
    }

    // Default deny: anything not explicitly matched above is unreachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
