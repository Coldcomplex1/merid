rules_version = '2';

// Merid Cloud Storage rules.
//
// Only one thing lives here: images uploaded from the blog admin. Everything
// else is default-deny.
//
// Admin identity is defined in exactly one place, the admins/{uid} collection in
// Firestore, and read from here via firestore.exists(). Keeping a single
// definition means granting or revoking blog access is one console action rather
// than two files that can drift apart.
service firebase.storage {
  match /b/{bucket}/o {

    function isBlogAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Blog images. Public to read, because they are displayed on public pages
    // and are served straight to anonymous readers and crawlers.
    match /blog/{allPaths=**} {
      allow read: if true;

      // 5 MB is generous for an article image; the editor downscales anything
      // large before it gets here, so hitting this ceiling means something went
      // wrong rather than someone uploading a legitimately big photo.
      allow write: if isBlogAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isBlogAdmin();
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
