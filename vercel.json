{
  "redirects": [
    {
      "source": "/en/blog",
      "destination": "/blog/en",
      "permanent": true
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/blog/en/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog-render" },
    { "source": "/blog/:lang", "destination": "/api/blog-render" },
    { "source": "/blog/:lang/:slug", "destination": "/api/blog-render" },
    { "source": "/sitemap.xml", "destination": "/api/blog-render" },
    { "source": "/llms.txt", "destination": "/api/blog-render" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/blog/screenshots/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
